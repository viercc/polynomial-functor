cabal-version:      3.0
name:               comonad-distributive-laws
version:            0

description:
  Not a library. A note on comonad distiributive laws.

license:            BSD-3-Clause
license-file:       LICENSE
author:             Koji Miyazato
maintainer:         viercc@gmail.com

build-type:         Simple

common warnings

library distributive-laws
    ghc-options: -Wall
    default-language: Haskell2010
    hs-source-dirs:   src
    exposed-modules:
      DistAct, DistPoly
    
    build-depends:
      base >= 4.20 && < 5,
      transformers,
      comonad,
      singletons,
      acts-fd,
      polynomial-comonad
